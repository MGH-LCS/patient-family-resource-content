      "food_dining": {
        "blocks": [
          {
            "type": "section",
            "id": "cafes_section",
            "title": {
              "en": "MGH cafeterias & cafés",
              "es": "Cafeterías y cafés de MGH"
            },
            "chipLabel": {
              "en": "MGH Cafés",
              "es": "Cafés de MGH"
            },
            "intro": {
              "en": "Delicious and healthy food and coffee options are available across Mass General's cafés and cafeterias. Please speak with a food service staff member if you need assistance at any location.\n\nHours may be different on holidays.",
              "es": "En las cafeterías y cafés de Mass General hay opciones de comida y café deliciosas y saludables. Si necesita ayuda en cualquiera de ellos, hable con un miembro del personal de servicio de alimentos.\n\nEl horario puede ser diferente los días festivos."
            }
          },
          {
            "type": "infoCards",
            "id": "eat_street_cafe",
            "sites": [
              "*"
            ],
            "phases": [
              "just_arrived",
              "first_night",
              "first_days"
            ],
            "cards": [
              {
                "id": "eat_street_cafe",
                "title": {
                  "en": "Eat Street Café",
                  "es": "Eat Street Café"
                },
                "subtitle": {
                  "en": "Ellison Building, lower level.",
                  "es": "Edificio Ellison, nivel inferior."
                },
                "body": {
                  "en": "The hospital's main cafeteria, with a variety of choices and daily Choose Well Eat Well healthy and plant-centered options. Wheelchair accessible — ask a staff member or push the red button at the main entrance for help. Take the elevators directly off the PICU to the Basement (B) then follow the signage to the Eat Street Cafe.\n",
                  "es": "La cafetería principal del hospital, con gran variedad de opciones y platos saludables y a base de plantas del programa Choose Well Eat Well todos los días. Accesible para sillas de ruedas: pida ayuda a un miembro del personal o presione el botón rojo en la entrada principal. Tome los ascensores que están justo al salir de la PICU hasta el sótano (B) y siga las señales hasta Eat Street Café.\n"
                },
                "meta": {
                  "en": "Mon–Fri 6:30 am–8 pm · Sat, Sun 7 am–7 pm",
                  "es": "lun–vie 6:30–20:00 · sáb, dom 7:00–19:00"
